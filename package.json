{
  "name": "@dashfy/ext-github",
  "version": "0.1.0",
  "description": "Dashfy GitHub extension - Display GitHub data with beautiful widgets and charts",
  "keywords": [
    "dashfy",
    "dashboard",
    "widgets",
    "extension",
    "github",
    "charts",
    "recharts"
  ],
  "homepage": "https://github.com/dashfy/dashfy#readme",
  "bugs": {
    "url": "https://github.com/dashfy/dashfy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashfy/dashfy.git",
    "directory": "packages/ext-github"
  },
  "license": "MIT",
  "author": {
    "name": "Breno Polanski",
    "email": "breno.polanski@gmail.com",
    "url": "https://github.com/brenopolanski"
  },
  "type": "module",
  "dashfy": {
    "id": "github",
    "title": "GitHub",
    "categories": [
      "developer"
    ],
    "docs": "Create a token at https://github.com/settings/tokens",
    "widgets": [
      "UserBadge",
      "OrgBadge",
      "RepoBadge",
      "Status",
      "Branches",
      "PullRequests",
      "ContributorsStats",
      "CommitActivityLine",
      "Gitmap"
    ],
    "client": {
      "import": "@dashfy/ext-github",
      "factory": "createGitHubClient",
      "mode": "poll",
      "options": "{ token: process.env.GITHUB_TOKEN! }"
    },
    "envVars": [
      "GITHUB_TOKEN"
    ],
    "starter": [
      {
        "widget": "RepoBadge",
        "repository": "facebook/react"
      },
      {
        "widget": "Status"
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dashfy/types": "workspace:*",
    "@dashfy/ui": "workspace:*",
    "@dashfy/utils": "workspace:*",
    "colord": "^2.9.3"
  },
  "peerDependencies": {
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@dashfy/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.8.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.454.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.4"
  }
}
